# Copia este archivo como .env.local y rellena con los valores de tu proyecto Supabase
# Panel de Supabase -> Project Settings -> API

# URL del proyecto (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publica "anon" (anon / public key) - es segura de exponer al cliente,
# los permisos reales los controla Row Level Security (RLS) en Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# URL base de tu app, usada para construir el link de confirmacion de email
# En local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# En produccion, cambiar por la URL real de Vercel/Netlify, ej:
# NEXT_PUBLIC_SITE_URL=https://tarea16-auth.vercel.app
